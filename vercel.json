{
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/public/assets/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/(css|js)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "LOG_CHANNEL": "stderr",
        "APP_KEY": "base64:QFykyEYN/6w8gtQzr2aXYNIHpIT+Mu15OrJRVLYCpgg=",
        "DB_CONNECTION": "sqlite",
        "DB_DATABASE": "/var/task/database/database.sqlite",
        "SESSION_DRIVER": "cookie",
        "CACHE_DRIVER": "array"
    }
}
